# ForensIQ Environment Configuration Template
# Copy this file to .env and insert your real production tokens:

# AI Model Inference (Tier 2 & Tier 3)
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
HUGGINGFACE_API_TOKEN="your-huggingface-token"

# Security & Access Control
API_KEY_REQUIRED=false
FORENSIQ_API_KEY="your-forensiq-client-api-key"
ADMIN_SECRET_KEY="your-admin-secret-key-for-backups"

# Supabase (Database & Authentication)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# DATABASE_URL="postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres"

# Error Tracking & Observability (Sentry)
SENTRY_DSN=""
ENVIRONMENT="production"
